{
  "name": "@bettertui/performance",
  "version": "0.0.0",
  "private": true,
  "description": "Micro and end-to-end benchmark suite for BetterTUI",
  "type": "module",
  "scripts": {
    "bench": "vitest bench",
    "bench:run": "vitest bench --run",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bettertui/core": "workspace:*",
    "@bettertui/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
