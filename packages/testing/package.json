{
  "name": "@bettertui/testing",
  "version": "0.0.0",
  "description": "Testing utilities for BetterTUI applications",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bettertui/core": "workspace:*",
    "@bettertui/shared": "workspace:*",
    "@bettertui/react": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
