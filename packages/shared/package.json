{
  "name": "@bettertui/shared",
  "version": "0.1.1",
  "description": "Shared type definitions and protocols for the BetterTUI terminal UI framework",
  "keywords": ["types", "tui", "terminal", "protocol", "definitions"],
  "repository": {
    "type": "git",
    "url": "https://github.com/localfirstai/bettertui.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/localfirstai/bettertui/issues"
  },
  "homepage": "https://bettertui.dev",
  "author": "SOUMITRO-SAHA <soumitrosahaofficial@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "postbuild": "node ../../scripts/generateDistManifest.ts",
    "dev": "tsdown --watch",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  }
}
