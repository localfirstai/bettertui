{
  "name": "@bettertui/react",
  "version": "0.0.0",
  "private": true,
  "author": "SOUMITRO-SAHA <soumitrosahaofficial@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./jsx-runtime": {
      "import": "./dist/jsx-runtime.mjs",
      "types": "./dist/jsx-runtime.d.mts"
    },
    "./jsx-dev-runtime": {
      "import": "./dist/jsx-dev-runtime.mjs",
      "types": "./dist/jsx-dev-runtime.d.mts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bettertui/core": "workspace:*",
    "@bettertui/shared": "workspace:*",
    "react-reconciler": "^0.33.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-reconciler": "^0.33.0",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
