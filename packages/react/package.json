{
  "name": "@bettertui/react",
  "version": "0.1.0",
  "private": true,
  "description": "React renderer for building terminal user interfaces with BetterTUI core",
  "keywords": ["react", "tui", "terminal", "terminal-ui", "jsx", "renderer"],
  "repository": {
    "type": "git",
    "url": "https://github.com/localfirstai/bettertui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/localfirstai/bettertui/issues"
  },
  "homepage": "https://bettertui.dev",
  "author": "SOUMITRO-SAHA <soumitrosahaofficial@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.mts",
      "import": "./dist/jsx-runtime.mjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.mts",
      "import": "./dist/jsx-dev-runtime.mjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "postbuild": "node ../../scripts/generateDistManifest.ts",
    "dev": "tsdown --watch",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bettertui/core": "workspace:*",
    "@bettertui/shared": "workspace:*",
    "react-reconciler": "^0.33.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-reconciler": "^0.33.0",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
