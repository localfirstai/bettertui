{
  "name": "@bettertui/examples",
  "version": "0.0.0",
  "private": true,
  "description": "BetterTUI vanilla TypeScript examples and standalone executable",
  "author": {
    "name": "SOUMITRO-SAHA",
    "email": "soumitrosahaofficial@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
