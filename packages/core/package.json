{
  "name": "@bettertui/core",
  "version": "0.0.0",
  "private": true,
  "description": "High-performance terminal UI framework powered by a Rust engine - framework-agnostic core (CommandBuffer, Runtime, tree reconciliation)",
  "keywords": ["tui", "terminal", "terminal-ui", "cli", "rust", "napi", "reconciler"],
  "repository": {
    "type": "git",
    "url": "https://github.com/bettertui/bettertui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/bettertui/bettertui/issues"
  },
  "homepage": "https://github.com/bettertui/bettertui/tree/main/packages/core#readme",
  "author": "SOUMITRO-SAHA <soumitrosahaofficial@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown && pnpm run build:native",
    "postbuild": "node ../../scripts/generateDistManifest.ts",
    "build:native": "export PATH=\"$HOME/.cargo/bin:$PATH\"; napi build --manifest-path crates/engine/Cargo.toml --features napi --release --output-dir ./dist --dts ../crates/engine/index.d.ts && cp crates/engine/index.d.ts ./dist/",
    "build:native:debug": "export PATH=\"$HOME/.cargo/bin:$PATH\"; napi build --manifest-path crates/engine/Cargo.toml --features napi --output-dir ./dist --dts ../crates/engine/index.d.ts && cp crates/engine/index.d.ts ./dist/",
    "dev": "tsdown --watch",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "publish": "node scripts/publish.ts",
    "release:rust": "export PATH=\"$HOME/.cargo/bin:$PATH\"; cargo publish --locked --manifest-path crates/engine/Cargo.toml",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bettertui/shared": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "napi": {
    "binaryName": "bettertui_engine"
  }
}
