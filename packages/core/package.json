{
  "name": "@bettertui/core",
  "version": "0.0.0",
  "private": true,
  "author": "SOUMITRO-SAHA <soumitrosahaofficial@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "build:native": "node scripts/build-native.ts",
    "build:native:all": "node scripts/build-native.ts --all",
    "dev": "tsdown --watch",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "publish": "node scripts/publish.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bettertui/shared": "workspace:*"
  },
  "optionalDependencies": {
    "@bettertui/core-darwin-x64": "0.0.0",
    "@bettertui/core-darwin-arm64": "0.0.0",
    "@bettertui/core-linux-x64-gnu": "0.0.0",
    "@bettertui/core-linux-arm64-gnu": "0.0.0",
    "@bettertui/core-linux-x64-musl": "0.0.0",
    "@bettertui/core-linux-arm64-musl": "0.0.0",
    "@bettertui/core-win32-x64": "0.0.0",
    "@bettertui/core-win32-arm64": "0.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
