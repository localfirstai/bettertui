{
  "name": "@bettertui/core",
  "version": "0.0.0",
  "private": true,
  "author": "SOUMITRO-SAHA <soumitrosahaofficial@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": ["dist", "bettertui_engine.node"],
  "scripts": {
    "build": "tsdown && pnpm run build:native",
    "build:native": "napi build --manifest-path crates/engine/Cargo.toml --features napi --release --output-dir ./dist --dts ../crates/engine/index.d.ts && cp crates/engine/index.d.ts ./dist/",
    "build:native:debug": "napi build --manifest-path crates/engine/Cargo.toml --features napi --output-dir ./dist --dts ../crates/engine/index.d.ts && cp crates/engine/index.d.ts ./dist/",
    "dev": "tsdown --watch",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "publish": "node scripts/publish.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bettertui/shared": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "napi": {
    "name": "bettertui_engine",
    "triples": {
      "defaults": true,
      "additional": []
    }
  }
}
