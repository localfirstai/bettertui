{
  "name": "bettertui",
  "private": true,
  "version": "0.0.0",
  "description": "High-performance terminal UI framework powered by Rust and TypeScript",
  "author": "SOUMITRO-SAHA <soumitrosahaofficial@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bettertui/bettertui.git"
  },
  "scripts": {
    "build": "turbo run build",
    "build:native": "turbo run build:native",
    "build:native:all": "turbo run build:native:all",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm cargo:check",
    "check:docs": "node scripts/check-doc-links.mjs",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "bench:ts": "pnpm --filter @bettertui/benchmark exec vitest bench --run",
    "bench": "pnpm bench:ts",
    "bench:watch": "pnpm --filter @bettertui/benchmark bench",
    "cargo:check": "cargo check --manifest-path packages/core/Cargo.toml",
    "cargo:test": "cargo test --manifest-path packages/core/Cargo.toml",
    "cargo:fmt": "cargo fmt --manifest-path packages/core/Cargo.toml --all",
    "cargo:clippy": "cargo clippy --manifest-path packages/core/Cargo.toml -- -D warnings",
    "cargo:build": "cargo build --manifest-path packages/core/Cargo.toml",
    "postcargo:build": "node -e \"const fs=require('fs'); const p=require('path'); const exts=['.dylib','.so','.dll']; for (const e of exts) { const f=p.join('packages/core/target/debug/libbettertui_bindings'+e); if(fs.existsSync(f)) fs.copyFileSync(f, p.join('packages/core/target/debug/bettertui_bindings.node')); }\"",
    "prepare-release": "node scripts/prepare-release.ts",
    "pre-publish": "node scripts/pre-publish.ts",
    "publish": "node scripts/publish.ts",
    "clean": "turbo run clean && cargo clean --manifest-path packages/core/Cargo.toml",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@napi-rs/cli": "^3.7.3",
    "@vitest/coverage-v8": "^3.2.7",
    "husky": "^9.1.7",
    "turbo": "^2.4.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.15.0"
  }
}
