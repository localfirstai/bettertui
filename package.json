{
  "name": "bettertui",
  "private": true,
  "version": "0.0.0",
  "description": "High-performance terminal UI framework powered by Rust and TypeScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bettertui/bettertui.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm cargo:check",
    "cargo:check": "cargo check --workspace",
    "cargo:test": "cargo test --workspace",
    "cargo:fmt": "cargo fmt --all",
    "cargo:clippy": "cargo clippy --workspace -- -D warnings",
    "clean": "turbo run clean && cargo clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "husky": "^9.1.7",
    "turbo": "^2.4.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
