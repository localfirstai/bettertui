{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bettertui-website",
  "compatibility_date": "2026-08-22",
  "routes": [
    { "pattern": "bettertui.dev", "custom_domain": true },
    { "pattern": "www.bettertui.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "preview_urls": true,
  "workers_dev": false
}
