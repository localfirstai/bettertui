---
const benchmarks = [
  { label: "Initial Render", value: "< 16ms", description: "Full component tree to first frame" },
  { label: "Re-render", value: "< 2ms", description: "Dirty rect diffing, only changed cells" },
  { label: "Memory", value: "< 5MB", description: "Typical CLI app footprint" },
  { label: "Frame Target", value: "60fps", description: "vsync-aligned frame scheduling" },
];
---

<section class="border-t border-border py-24">
  <div class="container">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">Performance</h2>
      <p class="text-text-muted">
        Native Rust rendering. Zero overhead abstraction.
      </p>
    </div>

    <div class="mx-auto grid max-w-4xl gap-6 md:grid-cols-2 lg:grid-cols-4">
      {benchmarks.map((bench) => (
        <div class="rounded-xl border border-border bg-surface p-6 text-center">
          <div class="mb-2 text-3xl font-bold gradient-text">{bench.value}</div>
          <div class="mb-1 text-sm font-semibold">{bench.label}</div>
          <div class="text-xs text-text-subtle">{bench.description}</div>
        </div>
      ))}
    </div>

    <div class="mx-auto mt-12 max-w-4xl">
      <div class="overflow-hidden rounded-xl border border-border bg-surface p-8">
        <h3 class="mb-4 text-lg font-semibold">Engine Modules</h3>
        <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
          {[
            "Renderer", "Layout (Taffy)", "Scheduler", "Frame Buffer",
            "Event System", "Keyboard", "Mouse", "Selection",
            "Clipboard", "Editor", "Animation", "Widgets",
          ].map((mod) => (
            <div class="flex items-center gap-2 rounded-lg bg-bg-muted px-3 py-2 text-sm">
              <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
              {mod}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
