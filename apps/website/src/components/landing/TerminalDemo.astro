---
---

<section class="border-t border-border bg-muted/50 py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <p class="font-mono text-xs font-medium uppercase tracking-wider text-terminal">
        See it in action
      </p>
      <h2 class="text-section mt-2">From install to running in minutes</h2>
      <p class="text-section-sub mt-4 text-muted-foreground">
        The Rust engine initialises on first import. No configuration. No build step.
      </p>
    </div>

    <div class="mx-auto max-w-4xl">
      <div class="code-window overflow-hidden rounded-xl border border-code-border">
        <div
          class="flex items-center gap-1.5 border-b border-code-border bg-background/50 px-4 py-3"
        >
          <div class="h-3 w-3 rounded-full bg-red-400/80"></div>
          <div class="h-3 w-3 rounded-full bg-yellow-400/80"></div>
          <div class="h-3 w-3 rounded-full bg-green-400/80 terminal-dot-pulse"></div>
          <span class="ml-2 font-mono text-xs text-muted-foreground">terminal</span>
          <div class="ml-auto flex gap-2">
            <span class="rounded bg-white/10 px-2 py-0.5 font-mono text-[10px] text-muted-foreground"
              >~/my-app</span
            >
          </div>
        </div>

        <div class="space-y-1 p-6 font-mono text-sm leading-relaxed">
          <div>
            <span class="text-muted-foreground">$ </span>
            <span>npm install @bettertui/core @bettertui/react</span>
          </div>
          <div class="text-terminal">✓ Added 2 packages</div>
          <div class="mt-3">
            <span class="text-muted-foreground">$ </span>
            <span>node --loader ts-node/esm app.tsx</span>
          </div>
          <div class="text-terminal">✓ Rust engine loaded (native .node addon)</div>
          <div class="text-terminal">✓ Reconciler ready</div>

          <div class="mt-4 rounded border border-border bg-card p-4">
            <div
              class="mb-2 flex items-center gap-4 border-b border-border pb-2 font-mono text-xs text-muted-foreground"
            >
              <span class="text-terminal">●</span>
              <span class="font-semibold text-foreground">BetterTUI Dashboard</span>
              <span class="ml-auto">
                Press <kbd class="rounded bg-white/15 px-1.5 py-0.5 text-foreground">Tab</kbd> to navigate
              </span>
            </div>
            <div class="space-y-1.5">
              <div class="flex items-center justify-between rounded px-2 py-1.5 bg-terminal-muted/40">
                <div class="flex items-center gap-3">
                  <span class="text-terminal">▶</span>
                  <span class="font-semibold">CPU</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-terminal">████████░░</span>
                  <span class="text-muted-foreground">81%</span>
                </div>
              </div>
              <div class="flex items-center justify-between rounded px-2 py-1.5 hover:bg-white/8">
                <div class="flex items-center gap-3">
                  <span class="text-muted-foreground">▷</span>
                  <span>Memory</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-muted-foreground">████░░░░░░</span>
                  <span class="text-muted-foreground">42%</span>
                </div>
              </div>
              <div class="flex items-center justify-between rounded px-2 py-1.5 hover:bg-white/8">
                <div class="flex items-center gap-3">
                  <span class="text-muted-foreground">▷</span>
                  <span>Rust engine</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-terminal">█░░░░░░░░░</span>
                  <span class="text-terminal text-xs">~0ms garbage collection</span>
                </div>
              </div>
            </div>
          </div>
          <div class="mt-2 text-muted-foreground">
            Press <kbd class="rounded bg-white/15 px-1 py-0.5 text-xs">q</kbd> to quit
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Terminal window glow ── */
  .code-window {
    box-shadow:
      0 32px 80px -12px oklch(0 0 0 / 0.12),
      inset 0 1px 0 oklch(1 0 0 / 0.06);
  }
  :global(.dark) .code-window {
    box-shadow: 0 32px 80px -12px oklch(0 0 0 / 0.65);
  }


</style>
