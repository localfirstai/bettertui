---
const L = "{";
const R = "}";

const kw = "text-syntax-keyword";
const fn = "text-syntax-function";
const num = "text-syntax-number";
const tag = "text-syntax-tag";
const attr = "text-syntax-attr";
const op = "text-syntax-operator";
const str = "text-syntax-string";
const fg = "text-foreground";
const cm = "text-muted-foreground";

const code1Html = `<span class="${kw}">import</span><span class="${fg}"> { Box, Text, useInput } </span><span class="${kw}">from</span><span class="${str}"> "bettertui"</span><span class="${fg}">;</span>
<span></span>
<span class="${kw}">function</span><span class="${fg}"> </span><span class="${fn}">App</span><span class="${fg}">() ${L}</span>
<span class="${fg}">  </span><span class="${kw}">const</span><span class="${fg}"> [count, setCount] = </span><span class="${fn}">useState</span><span class="${fg}">(</span><span class="${num}">0</span><span class="${fg}">);</span>
<span></span>
<span class="${fg}">  </span><span class="${fn}">useInput</span><span class="${fg}">((input) </span><span class="${op}">=&gt;</span><span class="${fg}"> ${L}</span>
<span class="${fg}">    </span><span class="${kw}">if</span><span class="${fg}"> (input === </span><span class="${str}">"q"</span><span class="${fg}">) </span><span class="${fn}">process.exit</span><span class="${fg}">();</span>
<span class="${fg}">  ${R});</span>
<span></span>
<span class="${fg}">  </span><span class="${kw}">return</span><span class="${fg}"> (</span>
<span class="${fg}">    </span><span class="${op}">&lt;</span><span class="${tag}">Box</span><span class="${fg}"> </span><span class="${attr}">borderStyle</span><span class="${fg}">=</span><span class="${str}">"round"</span><span class="${fg}"> </span><span class="${attr}">padding</span><span class="${fg}">=${L}</span><span class="${num}">1</span><span class="${fg}">${R}&gt;</span>
<span class="${fg}">      </span><span class="${op}">&lt;</span><span class="${tag}">Text</span><span class="${fg}"> </span><span class="${attr}">color</span><span class="${fg}">=</span><span class="${str}">"green"</span><span class="${fg}">&gt;Count: ${L}count${R}&lt;/</span><span class="${tag}">Text</span><span class="${fg}">&gt;</span>
<span class="${fg}">      </span><span class="${op}">&lt;</span><span class="${tag}">Text</span><span class="${fg}"> </span><span class="${attr}">dimColor</span><span class="${fg}">&gt;Press 'q' to quit&lt;/</span><span class="${tag}">Text</span><span class="${fg}">&gt;</span>
<span class="${fg}">    </span><span class="${op}">&lt;/</span><span class="${tag}">Box</span><span class="${fg}">&gt;</span>
<span class="${fg}">  );</span>
<span class="${fg}">${R}</span>`;

const code2Html = `<span class="${cm}">// React</span>
<span class="${kw}">import</span><span class="${fg}"> { render } </span><span class="${kw}">from</span><span class="${str}"> "bettertui/react"</span><span class="${fg}">;</span>
<span></span>
<span class="${cm}">// SolidJS</span>
<span class="${kw}">import</span><span class="${fg}"> { render } </span><span class="${kw}">from</span><span class="${str}"> "bettertui/solid"</span><span class="${fg}">;</span>
<span></span>
<span class="${cm}">// Astro</span>
<span class="${kw}">import</span><span class="${fg}"> BetterTUI </span><span class="${kw}">from</span><span class="${str}"> "bettertui/astro"</span><span class="${fg}">;</span>`;
---

<section class="py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <p class="font-mono text-xs font-medium uppercase tracking-wider text-terminal">How it works</p>
      <h2 class="text-section mt-2">Define your UI</h2>
      <p class="text-section-sub mt-4 max-w-2xl text-muted-foreground">
        Familiar component patterns. Write once, run in any terminal.
      </p>
    </div>

    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <div class="relative overflow-hidden rounded-xl border border-code-border bg-code-bg">
          <div class="flex items-center gap-1.5 border-b border-code-border px-4 py-3">
            <div class="h-3 w-3 rounded-full bg-red-400/80" />
            <div class="h-3 w-3 rounded-full bg-yellow-400/80" />
            <div class="h-3 w-3 rounded-full bg-green-400/80" />
            <span class="ml-2 font-mono text-xs text-muted-foreground">App.tsx</span>
          </div>
          <pre class="overflow-x-auto p-4"><code class="font-mono text-code leading-relaxed" set:html={code1Html} /></pre>
        </div>
      </div>

      <div class="flex flex-col items-center justify-center">
        <div class="w-full max-w-sm rounded-xl border-2 border-terminal/30 bg-code-bg p-6 shadow-lg">
          <div class="mb-3 flex items-center gap-1.5">
            <div class="h-2.5 w-2.5 rounded-full bg-red-400/80" />
            <div class="h-2.5 w-2.5 rounded-full bg-yellow-400/80" />
            <div class="h-2.5 w-2.5 rounded-full bg-green-400/80" />
          </div>
          <div class="rounded border border-border bg-background p-4 font-mono text-sm">
            <div class="text-terminal font-semibold">Count: 0</div>
            <div class="mt-1 text-muted-foreground">Press 'q' to quit</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

