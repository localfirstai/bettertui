---
const L = "{";
const R = "}";

const kw = "text-syntax-keyword";
const fn_ = "text-syntax-function";
const num = "text-syntax-number";
const tag = "text-syntax-tag";
const attr = "text-syntax-attr";
const op = "text-syntax-operator";
const str = "text-syntax-string";
const fg = "text-foreground";
const cm = "text-muted-foreground";

const reactCodeHtml = `<span class="${kw}">import</span><span class="${fg}"> ${L} Box, Text, useInput ${R} </span><span class="${kw}">from</span><span class="${str}"> "@bettertui/react"</span><span class="${fg}">;</span>
<span class="${kw}">import</span><span class="${fg}"> ${L} render ${R} </span><span class="${kw}">from</span><span class="${str}"> "@bettertui/core"</span><span class="${fg}">;</span>
<span></span>
<span class="${kw}">function</span><span class="${fg}"> </span><span class="${fn_}">App</span><span class="${fg}">() ${L}</span>
<span class="${fg}">  </span><span class="${fn_}">useInput</span><span class="${fg}">((key) </span><span class="${op}">=&gt;</span><span class="${fg}"> ${L}</span>
<span class="${fg}">    </span><span class="${kw}">if</span><span class="${fg}"> (key === </span><span class="${str}">"q"</span><span class="${fg}">) process.</span><span class="${fn_}">exit</span><span class="${fg}">(</span><span class="${num}">0</span><span class="${fg}">);</span>
<span class="${fg}">  ${R});</span>
<span></span>
<span class="${fg}">  </span><span class="${kw}">return</span><span class="${fg}"> (</span>
<span class="${fg}">    </span><span class="${op}">&lt;</span><span class="${tag}">Box</span><span class="${fg}"> </span><span class="${attr}">flexDirection</span><span class="${fg}">=</span><span class="${str}">"column"</span><span class="${fg}"> </span><span class="${attr}">padding</span><span class="${fg}">=${L}</span><span class="${num}">1</span><span class="${fg}">${R}&gt;</span>
<span class="${fg}">      </span><span class="${op}">&lt;</span><span class="${tag}">Text</span><span class="${fg}"> </span><span class="${attr}">bold</span><span class="${fg}"> </span><span class="${attr}">color</span><span class="${fg}">=</span><span class="${str}">"green"</span><span class="${fg}">&gt;Count: ${L}count${R}&lt;/</span><span class="${tag}">Text</span><span class="${fg}">&gt;</span>
<span class="${fg}">      </span><span class="${op}">&lt;</span><span class="${tag}">Text</span><span class="${fg}"> </span><span class="${attr}">dimColor</span><span class="${fg}">&gt;Press q to quit&lt;/</span><span class="${tag}">Text</span><span class="${fg}">&gt;</span>
<span class="${fg}">    </span><span class="${op}">&lt;/</span><span class="${tag}">Box</span><span class="${fg}">&gt;</span>
<span class="${fg}">  );</span>
<span class="${fg}">${R}</span>
<span></span>
<span class="${fn_}">render</span><span class="${fg}">(</span><span class="${op}">&lt;</span><span class="${tag}">App</span><span class="${fg}"> /&gt;);</span>`;

const solidCodeHtml = `<span class="${kw}">import</span><span class="${fg}"> ${L} Box, Text, useInput ${R} </span><span class="${kw}">from</span><span class="${str}"> "@bettertui/solid"</span><span class="${fg}">;</span>
<span class="${kw}">import</span><span class="${fg}"> ${L} render ${R} </span><span class="${kw}">from</span><span class="${str}"> "@bettertui/core"</span><span class="${fg}">;</span>
<span class="${kw}">import</span><span class="${fg}"> ${L} createSignal ${R} </span><span class="${kw}">from</span><span class="${str}"> "solid-js"</span><span class="${fg}">;</span>
<span></span>
<span class="${kw}">function</span><span class="${fg}"> </span><span class="${fn_}">App</span><span class="${fg}">() ${L}</span>
<span class="${fg}">  </span><span class="${kw}">const</span><span class="${fg}"> [count, setCount] = </span><span class="${fn_}">createSignal</span><span class="${fg}">(</span><span class="${num}">0</span><span class="${fg}">);</span>
<span></span>
<span class="${fg}">  </span><span class="${fn_}">useInput</span><span class="${fg}">((key) </span><span class="${op}">=&gt;</span><span class="${fg}"> ${L}</span>
<span class="${fg}">    </span><span class="${kw}">if</span><span class="${fg}"> (key === </span><span class="${str}">"+"</span><span class="${fg}">) </span><span class="${fn_}">setCount</span><span class="${fg}">((n) </span><span class="${op}">=&gt;</span><span class="${fg}"> n + </span><span class="${num}">1</span><span class="${fg}">);</span>
<span class="${fg}">  ${R});</span>
<span></span>
<span class="${fg}">  </span><span class="${kw}">return</span><span class="${fg}"> (</span>
<span class="${fg}">    </span><span class="${op}">&lt;</span><span class="${tag}">Box</span><span class="${fg}"> </span><span class="${attr}">padding</span><span class="${fg}">=${L}</span><span class="${num}">1</span><span class="${fg}">${R}&gt;</span>
<span class="${fg}">      </span><span class="${op}">&lt;</span><span class="${tag}">Text</span><span class="${fg}"> </span><span class="${attr}">color</span><span class="${fg}">=</span><span class="${str}">"cyan"</span><span class="${fg}">&gt;Count: ${L}</span><span class="${fn_}">count</span><span class="${fg}">()${R}&lt;/</span><span class="${tag}">Text</span><span class="${fg}">&gt;</span>
<span class="${fg}">    </span><span class="${op}">&lt;/</span><span class="${tag}">Box</span><span class="${fg}">&gt;</span>
<span class="${fg}">  );</span>
<span class="${fg}">${R}</span>`;
---

<section class="border-t border-border bg-muted/40 py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <p class="font-mono text-xs font-medium uppercase tracking-wider text-terminal">
        How it works
      </p>
      <h2 class="text-section mt-2">Familiar patterns. Native speed.</h2>
      <p class="text-section-sub mt-4 text-muted-foreground">
        Write components exactly like you would for the web. BetterTUI translates them to the
        terminal through its Rust engine.
      </p>
    </div>

    <!-- Tab switcher -->
    <div class="mx-auto max-w-3xl">
      <div class="mb-4 flex items-center gap-1 rounded-lg border border-white/15 bg-muted p-1">
        <button
          id="tab-react"
          class="code-tab flex-1 rounded-md px-4 py-2 font-mono text-sm font-medium transition-all"
          data-active="true"
          aria-selected="true"
        >
          React
        </button>
        <button
          id="tab-solid"
          class="code-tab flex-1 rounded-md px-4 py-2 font-mono text-sm font-medium transition-all"
          data-active="false"
          aria-selected="false"
        >
          SolidJS
        </button>
      </div>

      <div class="code-window overflow-hidden rounded-xl border border-code-border">
        <div class="flex items-center gap-1.5 border-b border-code-border px-4 py-3">
          <div class="h-3 w-3 rounded-full bg-red-400/80"></div>
          <div class="h-3 w-3 rounded-full bg-yellow-400/80"></div>
          <div class="h-3 w-3 rounded-full bg-green-400/80"></div>
          <span id="code-filename" class="ml-2 font-mono text-xs text-muted-foreground"
            >app.tsx</span
          >
        </div>
        <div id="code-react" class="code-panel">
          <pre class="overflow-x-auto p-4"><code
              class="font-mono text-code leading-relaxed"
              set:html={reactCodeHtml}
            /></pre>
        </div>
        <div id="code-solid" class="code-panel hidden">
          <pre class="overflow-x-auto p-4"><code
              class="font-mono text-code leading-relaxed"
              set:html={solidCodeHtml}
            /></pre>
        </div>
      </div>
    </div>

    <!-- Output preview -->
    <div class="mx-auto mt-12 max-w-3xl">
      <p
        class="mb-4 text-center font-mono text-[10px] uppercase tracking-widest text-muted-foreground"
      >
        Terminal output
      </p>
      <div class="code-window overflow-hidden rounded-xl border-2 border-terminal/30 shadow-lg">
        <div class="flex items-center gap-1.5 border-b border-code-border px-4 py-3">
          <div class="h-2.5 w-2.5 rounded-full bg-red-400/80"></div>
          <div class="h-2.5 w-2.5 rounded-full bg-yellow-400/80"></div>
          <div class="h-2.5 w-2.5 rounded-full bg-green-400/80 terminal-dot-pulse"></div>
          <span class="ml-2 font-mono text-xs text-muted-foreground/60">my-app</span>
        </div>
        <div class="rounded border border-border bg-card p-4 font-mono text-sm m-4">
          <div class="font-bold text-terminal">● Count: 0</div>
          <div class="mt-1 text-muted-foreground">Press q to quit</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .code-tab[data-active="true"] {
    background-color: var(--background);
    color: var(--foreground);
    box-shadow: 0 1px 4px oklch(0 0 0 / 0.12), 0 0 0 1px var(--border);
  }
  .code-tab[data-active="false"] {
    color: var(--muted-foreground);
  }
  .code-tab[data-active="false"]:hover {
    color: var(--foreground);
  }
</style>

<script>
  const tabReact = document.getElementById("tab-react");
  const tabSolid = document.getElementById("tab-solid");
  const panelReact = document.getElementById("code-react");
  const panelSolid = document.getElementById("code-solid");
  const filename = document.getElementById("code-filename");

  function activateTab(tab: "react" | "solid") {
    const isReact = tab === "react";
    tabReact?.setAttribute("data-active", String(isReact));
    tabReact?.setAttribute("aria-selected", String(isReact));
    tabSolid?.setAttribute("data-active", String(!isReact));
    tabSolid?.setAttribute("aria-selected", String(!isReact));
    panelReact?.classList.toggle("hidden", !isReact);
    panelSolid?.classList.toggle("hidden", isReact);
    if (filename) filename.textContent = isReact ? "app.tsx" : "app.tsx";
  }

  tabReact?.addEventListener("click", () => activateTab("react"));
  tabSolid?.addEventListener("click", () => activateTab("solid"));
</script>
