---
const features = [
  {
    icon: "zap",
    title: "Rust-Powered Rendering",
    description:
      "60fps terminal rendering powered by a native Rust engine. Dirty rect diffing, layout caching, and memory pooling — zero config.",
  },
  {
    icon: "react",
    title: "React First-Class",
    description:
      "Build terminal UIs with React components, hooks, and state management. Custom reconciler, not Ink. Full React 19 support.",
  },
  {
    icon: "layout",
    title: "Flexbox Layout",
    description:
      "CSS Flexbox layout via Taffy. Responsive, predictable, familiar. No custom layout DSL to learn.",
  },
  {
    icon: "palette",
    title: "Theme System",
    description:
      "Built-in theming with CSS variables. Dark mode, custom palettes, and design tokens out of the box.",
  },
  {
    icon: "box",
    title: "Rich Widget Library",
    description:
      "Text, Input, Table, Tree, Dialog, and more. Accessible, composable, and fully typed.",
  },
  {
    icon: "terminal",
    title: "Framework Agnostic Engine",
    description:
      "The Rust engine has zero framework knowledge. Clean API boundary. Adapters for React, Vue, Solid, and Svelte.",
  },
];
---

<section class="py-24">
  <div class="container">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">Built for performance</h2>
      <p class="text-text-muted">
        Every architectural decision optimizes for speed. The Rust engine handles rendering, layout,
        and input. React handles the UI.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <div class="group rounded-xl border border-border bg-surface p-6 transition-all hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-muted">
            {feature.icon === "zap" && (
              <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            )}
            {feature.icon === "react" && (
              <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="3" stroke-width="2"></circle>
                <ellipse cx="12" cy="12" rx="10" ry="4" stroke-width="2" transform="rotate(0 12 12)"></ellipse>
                <ellipse cx="12" cy="12" rx="10" ry="4" stroke-width="2" transform="rotate(60 12 12)"></ellipse>
                <ellipse cx="12" cy="12" rx="10" ry="4" stroke-width="2" transform="rotate(120 12 12)"></ellipse>
              </svg>
            )}
            {feature.icon === "layout" && (
              <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <rect x="3" y="3" width="18" height="18" rx="2" stroke-width="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9" stroke-width="2"></line>
                <line x1="9" y1="21" x2="9" y2="9" stroke-width="2"></line>
              </svg>
            )}
            {feature.icon === "palette" && (
              <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
              </svg>
            )}
            {feature.icon === "box" && (
              <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
            )}
            {feature.icon === "terminal" && (
              <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            )}
          </div>
          <h3 class="mb-2 text-lg font-semibold">{feature.title}</h3>
          <p class="text-sm text-text-muted">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
