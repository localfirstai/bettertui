---
import { CursorClick, Feather, Globe, Keyboard, Palette, ShieldCheck } from "@phosphor-icons/react";

const features = [
  {
    icon: Globe,
    title: "Framework Agnostic",
    description: "Use React, SolidJS, Astro, or any framework. One API, infinite possibilities.",
  },
  {
    icon: ShieldCheck,
    title: "Type-Safe",
    description: "Full TypeScript support with autocomplete and compile-time safety.",
  },
  {
    icon: CursorClick,
    title: "Interactive Components",
    description: "Buttons, inputs, selects, tables, and more — all terminal-native.",
  },
  {
    icon: Palette,
    title: "Theming",
    description: "Built-in dark mode and custom theme support with CSS variables.",
  },
  {
    icon: Keyboard,
    title: "Keyboard Navigation",
    description: "Full keyboard support with focus management and shortcuts.",
  },
  {
    icon: Feather,
    title: "Lightweight",
    description: "Zero runtime overhead. Tree-shakeable and dependency-free core.",
  },
];
---

<section class="py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <p class="font-mono text-xs font-medium uppercase tracking-wider text-terminal">Features</p>
      <h2 class="text-section mt-2">Everything you need for terminal UIs</h2>
      <p class="text-section-sub mt-4 max-w-2xl text-muted-foreground">
        From interactive forms to real-time dashboards, BetterTUI provides the primitives you need.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <article class="group relative overflow-hidden rounded-xl border border-border/60 bg-card/50 backdrop-blur-sm transition-all duration-300 hover:border-border hover:-translate-y-0.5 hover:shadow-lg">
          <div class="p-6">
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-terminal-muted text-terminal">
              <feature.icon class="h-5 w-5" weight="bold" aria-hidden="true" />
            </div>
            <h3 class="text-lg font-semibold">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{feature.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
