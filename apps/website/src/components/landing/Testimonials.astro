---
const testimonials = [
  {
    name: "Sarah Chen",
    handle: "@sarahchen",
    avatar: "SC",
    text: "BetterTUI is exactly what the terminal ecosystem needed. React components that render in the terminal with actual proper layout and theming? Finally.",
    time: "2d ago",
  },
  {
    name: "Marcus Johnson",
    handle: "@marcusj",
    avatar: "MJ",
    text: "The framework-agnostic approach is brilliant. We migrated our CLI tool from Ink to BetterTUI in an afternoon. The TypeScript support is incredible.",
    time: "1w ago",
  },
  {
    name: "Akira Tanaka",
    handle: "@akiradev",
    avatar: "AT",
    text: "Been building a terminal dashboard for our deployment pipeline. The keyboard navigation and table components alone are worth the switch. Amazing DX.",
    time: "3d ago",
  },
];
---

<section class="border-t border-border py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <p class="font-mono text-xs font-medium uppercase tracking-wider text-muted-foreground">Loved by developers</p>
      <h2 class="text-section mt-2">What the community says</h2>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {testimonials.map((t) => (
        <article class="rounded-xl border border-border/60 bg-card p-6">
          <div class="mb-4 flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-terminal-muted font-mono text-sm font-medium text-terminal">
              {t.avatar}
            </div>
            <div>
              <div class="text-sm font-semibold">{t.name}</div>
              <div class="text-xs text-muted-foreground">{t.handle}</div>
            </div>
          </div>
          <p class="text-sm leading-relaxed text-muted-foreground">{t.text}</p>
          <div class="mt-3 text-xs text-muted-foreground/60">{t.time}</div>
        </article>
      ))}
    </div>
  </div>
</section>
