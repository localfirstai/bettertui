---
import { GITHUB_DISCUSSIONS_URL } from "@lib/constants";
import { GitFork, Package, Warning } from "@phosphor-icons/react";

const problems = [
  {
    icon: Warning,
    title: "GC Pauses",
    problem:
      "Pure-JS TUI renderers compete with your app for the GC. A 50ms GC pause in a real-time dashboard is visible and jarring.",
    solution:
      "The Rust engine never touches the JS heap. Layout and rendering are GC-free by construction.",
  },
  {
    icon: Package,
    title: "Bundle Bloat",
    problem:
      "Traditional TUI libs ship the full rendering engine in JS — parsing, layout, ANSI encoding. That's hundreds of kB in your bundle.",
    solution:
      "The JS layer is just a thin orchestration bridge. The heavy work lives in the native addon — outside your bundle entirely.",
  },
  {
    icon: GitFork,
    title: "Framework Lock-in",
    problem:
      "Ink is React-only. Blessed has no modern framework adapters. You either fight your framework or give up features.",
    solution:
      "First-class adapters for React 19 and SolidJS. Same Rust engine, same API, different reconciler.",
  },
];
---

<section class="border-t border-border py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <p class="font-mono text-xs font-medium uppercase tracking-wider text-terminal">Why BetterTUI</p>
      <h2 class="text-section mt-2">Solving the problems other TUI libs ignore</h2>
      <p class="text-section-sub mt-4 text-muted-foreground">
        Most terminal UI libraries are pure-JS wrappers. We went to the source.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {problems.map((item) => (
        <article class="comparison-card-hover flex flex-col overflow-hidden rounded-xl border border-border/60 bg-card/50">
          <div class="flex-1 p-6">
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-destructive/10 text-destructive">
              <item.icon class="h-5 w-5" weight="duotone" aria-hidden="true" />
            </div>
            <h3 class="text-base font-semibold">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.problem}</p>
          </div>
          <div class="border-t border-terminal/15 bg-terminal-muted/40 px-6 py-4">
            <p class="mb-1.5 font-mono text-[10px] font-semibold uppercase tracking-widest text-terminal">
              Our solution
            </p>
            <p class="text-sm leading-relaxed text-muted-foreground">{item.solution}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="mx-auto mt-12 max-w-2xl">
      <div class="rounded-xl border border-amber-400/30 bg-amber-400/10 px-6 py-5 text-center">
        <p class="font-mono text-sm font-semibold text-amber-600 dark:text-amber-400">
          ⚠ Early Beta — v0.0.0
        </p>
        <p class="mt-2 text-sm leading-relaxed text-amber-700/70 dark:text-amber-400/70">
          BetterTUI is not production-ready. The API is unstable and actively evolving. We're sharing
          early to collect feedback from the community.
        </p>
        <div class="mt-4 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="/roadmap"
            class="rounded-md border border-amber-400/40 px-4 py-2 text-sm font-medium text-amber-600 transition-colors hover:bg-amber-400/10 dark:border-amber-400/30 dark:text-amber-400"
          >
            View Roadmap →
          </a>
          <a
            href={GITHUB_DISCUSSIONS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md border border-amber-400/40 px-4 py-2 text-sm font-medium text-amber-600 transition-colors hover:bg-amber-400/10 dark:border-amber-400/30 dark:text-amber-400"
          >
            Join Discussion →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
