---
---

<section class="relative overflow-hidden py-24 md:py-32">
  <div class="absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-0 h-[600px] w-[600px] -translate-x-1/2 rounded-full bg-primary/5 blur-3xl"></div>
    <div class="absolute right-0 top-1/2 h-[400px] w-[400px] -translate-y-1/2 rounded-full bg-accent/5 blur-3xl"></div>
  </div>

  <div class="container">
    <div class="mx-auto max-w-4xl text-center">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-bg-muted px-4 py-1.5 text-sm text-text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
        v0.1.0-alpha
      </div>

      <h1 class="mb-6 text-5xl font-bold leading-tight tracking-tight md:text-7xl">
        Build
        <span class="gradient-text"> terminal UIs</span>
        <br />
        with React
      </h1>

      <p class="mx-auto mb-10 max-w-2xl text-lg text-text-muted md:text-xl">
        A high-performance terminal UI framework powered by a Rust rendering engine
        and React. Build beautiful, interactive CLI applications with familiar tools.
      </p>

      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href="/docs/getting-started/quick-start"
          class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-medium text-white transition-all hover:bg-primary-hover hover:shadow-lg hover:shadow-primary/25"
        >
          Get Started
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
        <a
          href="https://github.com/bettertui/bettertui"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-border bg-bg px-6 py-3 text-sm font-medium text-text transition-all hover:bg-bg-muted"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
          </svg>
          Star on GitHub
        </a>
      </div>

      <div class="mx-auto mt-16 max-w-3xl overflow-hidden rounded-xl border border-border bg-code-bg p-6 text-left shadow-2xl">
        <div class="mb-4 flex items-center gap-2">
          <div class="h-3 w-3 rounded-full bg-[#ff5f57]"></div>
          <div class="h-3 w-3 rounded-full bg-[#febc2e]"></div>
          <div class="h-3 w-3 rounded-full bg-[#28c840]"></div>
          <span class="ml-2 text-xs text-text-subtle">terminal</span>
        </div>
        <pre class="overflow-x-auto text-sm leading-relaxed"><code class="text-code-text"><span class="text-[#7c3aed]">npx</span> create-bettertui@latest my-app
<span class="text-text-subtle">cd</span> my-app
<span class="text-[#7c3aed]">pnpm</span> dev</code></pre>
      </div>
    </div>
  </div>
</section>
