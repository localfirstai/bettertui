---
import { CopyButton } from "@components/CopyButton";
import { GithubIcon } from "@components/icon";
import { Badge } from "@components/ui/badge";
import { Button } from "@components/ui/button";
import { GITHUB_URL } from "@lib/constants";

const L = "{";
const R = "}";

const kw = "text-syntax-keyword";
const fn = "text-syntax-function";
const num = "text-syntax-number";
const tag = "text-syntax-tag";
const attr = "text-syntax-attr";
const op = "text-syntax-operator";
const str = "text-syntax-string";
const fg = "text-foreground";

const codeHtml = `<span class="${kw}">import</span><span class="${fg}"> { Box, Text, useInput } </span><span class="${kw}">from</span><span class="${str}"> "bettertui"</span><span class="${fg}">;</span>
<span></span>
<span class="${kw}">function</span><span class="${fg}"> </span><span class="${fn}">App</span><span class="${fg}">() ${L}</span>
<span class="${fg}">  </span><span class="${kw}">const</span><span class="${fg}"> [count, setCount] = </span><span class="${fn}">useState</span><span class="${fg}">(</span><span class="${num}">0</span><span class="${fg}">);</span>
<span></span>
<span class="${fg}">  </span><span class="${fn}">useInput</span><span class="${fg}">((input) </span><span class="${op}">=&gt;</span><span class="${fg}"> ${L}</span>
<span class="${fg}">    </span><span class="${kw}">if</span><span class="${fg}"> (input === </span><span class="${str}">"q"</span><span class="${fg}">) </span><span class="${fn}">process.exit</span><span class="${fg}">();</span>
<span class="${fg}">  ${R});</span>
<span></span>
<span class="${fg}">  </span><span class="${kw}">return</span><span class="${fg}"> (</span>
<span class="${fg}">    </span><span class="${op}">&lt;</span><span class="${tag}">Box</span><span class="${fg}"> </span><span class="${attr}">borderStyle</span><span class="${fg}">=</span><span class="${str}">"round"</span><span class="${fg}"> </span><span class="${attr}">padding</span><span class="${fg}">=${L}</span><span class="${num}">1</span><span class="${fg}">${R}&gt;</span>
<span class="${fg}">      </span><span class="${op}">&lt;</span><span class="${tag}">Text</span><span class="${fg}"> </span><span class="${attr}">color</span><span class="${fg}">=</span><span class="${str}">"green"</span><span class="${fg}">&gt;Count: ${L}count${R}&lt;/</span><span class="${tag}">Text</span><span class="${fg}">&gt;</span>
<span class="${fg}">      </span><span class="${op}">&lt;</span><span class="${tag}">Text</span><span class="${fg}"> </span><span class="${attr}">dimColor</span><span class="${fg}">&gt;Press 'q' to quit&lt;/</span><span class="${tag}">Text</span><span class="${fg}">&gt;</span>
<span class="${fg}">    </span><span class="${op}">&lt;/</span><span class="${tag}">Box</span><span class="${fg}">&gt;</span>
<span class="${fg}">  );</span>
<span class="${fg}">${R}</span>`;
---

<section class="relative min-h-[80vh] overflow-hidden pt-16">
  <div class="dot-grid absolute inset-0 -z-10" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-hero-gradient-start/0 via-hero-gradient-start/50 to-background" />

  <div class="mx-auto flex min-h-[80vh] max-w-4xl flex-col items-center justify-center px-4 text-center sm:px-6">
    <Badge variant="secondary" class="mb-6 rounded-full px-3 py-1 text-xs font-medium">
      <span class="mr-1.5 text-terminal">●</span>
      v1.0 is now available
    </Badge>

    <h1 class="text-hero text-balance">
      Build Terminal UIs with
      <br />
      <span class="text-terminal">Any</span> Framework
    </h1>

    <p class="text-hero-sub mt-6 max-w-2xl text-balance text-muted-foreground">
      BetterTUI is the TypeScript-first toolkit for building beautiful, interactive terminal interfaces. Works with React, SolidJS, Astro, Vue, Svelte, and more.
    </p>

    <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row">
      <a href="/docs/getting-started/quick-start">
        <Button size="lg">Get Started</Button>
      </a>
      <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
        <Button variant="outline" size="lg">
          <GithubIcon class="h-4 w-4" />
          View on GitHub
        </Button>
      </a>
    </div>

    <div class="mt-6 flex items-center gap-2 rounded-lg border bg-muted px-4 py-2.5 font-mono text-sm">
      <span class="text-muted-foreground">$</span>
      <span>npm install bettertui@latest</span>
      <CopyButton text="npm install bettertui@latest" client:load />
    </div>

    <div class="mt-16 w-full max-w-3xl">
      <div class="overflow-hidden rounded-xl border border-border bg-code-bg shadow-2xl shadow-black/5 dark:shadow-black/20">
        <div class="flex items-center gap-1.5 border-b border-code-border px-4 py-3">
          <div class="h-3 w-3 rounded-full bg-red-400/80" />
          <div class="h-3 w-3 rounded-full bg-yellow-400/80" />
          <div class="h-3 w-3 rounded-full bg-green-400/80 terminal-dot-pulse" />
          <span class="ml-2 font-mono text-xs text-muted-foreground">App.tsx</span>
        </div>
        <pre class="overflow-x-auto p-4 text-left"><code class="font-mono text-code leading-relaxed" set:html={codeHtml} /></pre>
      </div>
    </div>
  </div>
</section>
