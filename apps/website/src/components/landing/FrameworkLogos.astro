<script>
  function updateIcons() {
    const isDark = document.documentElement.classList.contains("dark");
    document.querySelectorAll(".icon-pair").forEach((pair) => {
      const light = pair.querySelector(".icon-light") as HTMLElement | null;
      const dark = pair.querySelector(".icon-dark") as HTMLElement | null;
      if (light) light.style.display = isDark ? "none" : "block";
      if (dark) dark.style.display = isDark ? "block" : "none";
    });
  }

  updateIcons();

  const observer = new MutationObserver(updateIcons);
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["class"],
  });
</script>
