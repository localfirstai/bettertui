---
import { AstroIconLight, Preact, ReactLight, Solidjs, Svelte, Vue } from "@components/icon";

const frameworks = [
  { name: "React", Icon: ReactLight },
  { name: "SolidJS", Icon: Solidjs },
  { name: "Astro", Icon: AstroIconLight },
  { name: "Vue", Icon: Vue },
  { name: "Svelte", Icon: Svelte },
  { name: "Preact", Icon: Preact },
];
---

<section class="border-b border-border py-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p
      class="mb-6 text-center font-mono text-xs font-medium uppercase tracking-wider text-muted-foreground"
    >
      Works with
    </p>
    <div
      class="flex flex-wrap items-center justify-center gap-8 text-foreground/70 transition-colors hover:text-foreground md:gap-12 [&>div]:opacity-70 [&>div]:transition-opacity [&>div]:hover:opacity-100"
    >
      {
        frameworks.map((fw) => (
          <div class="flex flex-col items-center gap-2" title={fw.name}>
            <div class="h-7 w-auto md:h-9 [&>svg]:h-full [&>svg]:w-auto [&>svg]:[&_*]:fill-current">
              <fw.Icon aria-label={fw.name} role="img" />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
