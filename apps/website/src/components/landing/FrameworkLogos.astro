---

<section class="border-y border-border bg-muted/30 py-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="mb-6 text-center font-mono text-xs font-medium uppercase tracking-wider text-muted-foreground">Works with</p>
    <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
      {frameworks.map((fw) => (
        <div class="flex flex-col items-center gap-2" title={fw.name}>
          <svg
            class="h-6 opacity-50 transition-all hover:opacity-100 md:h-8"
            viewBox={fw.viewBox}
            fill="currentColor"
            aria-label={fw.name}
          >
            <path d={fw.path} />
          </svg>
        </div>
      ))}
    </div>
  </div>
</section>
