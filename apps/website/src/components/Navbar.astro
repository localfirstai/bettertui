---
import { ThemeToggle } from "@components/theme-toggle";
import { GithubIcon, LogoIcon, MenuIcon } from "@components/icon";
import { Button } from "@components/ui/button";
import { GITHUB_URL } from "@lib/constants";
---

<header
  class="fixed top-0 z-50 w-full border-b border-border bg-background/80 backdrop-blur-xl"
>
  <div
    class="relative mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <a href="/" class="flex items-center gap-2.5">
      <span class="block h-6 w-6 text-terminal [&>svg]:h-full [&>svg]:w-full">
        <LogoIcon />
      </span>
      <span class="font-sans text-lg font-semibold tracking-tight"
        >BetterTUI</span
      >
    </a>

    <nav
      class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-6 md:flex"
    >
      <a
        href="/getting-started/introduction"
        class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
        >Docs</a
      >
      <a
        href="/performance"
        class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
        >Performance</a
      >
      <a
        href="/blog"
        class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
        >Blog</a
      >
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle client:load />

      <div class="hidden items-center gap-2 sm:flex">
        <div class="h-5 w-px bg-border"></div>

        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
          <Button variant="outline" size="sm" className="gap-1.5">
            <GithubIcon class="h-3.5 w-3.5" />
            Star on GitHub
          </Button>
        </a>

        <a href="/getting-started/quick-start">
          <Button size="sm">Get Started</Button>
        </a>
      </div>

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-toggle"
        class="flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="block h-5 w-5 [&>svg]:h-full [&>svg]:w-full">
          <MenuIcon />
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-background px-4 py-4 md:hidden"
  >
    <nav class="flex flex-col gap-3">
      <a
        href="/getting-started/introduction"
        class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        >Docs</a
      >
      <a
        href="/performance"
        class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        >Performance</a
      >
      <a
        href="/blog"
        class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        >Blog</a
      >
      <hr class="border-border" />
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        >GitHub</a
      >
      <a
        href="/getting-started/quick-start"
        class="rounded-md px-3 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted"
        >Get Started</a
      >
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      menu.classList.toggle("hidden");
      menu.classList.toggle("flex");
    });
  }
</script>
