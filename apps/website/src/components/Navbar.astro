---
import { GithubIcon, LogoIcon, MenuIcon } from "@components/icon";
import { ThemeToggle } from "@components/theme-toggle";
import { Button } from "@components/ui/button";
import { GITHUB_URL } from "@lib/constants";
---

<header id="navbar" class="fixed top-0 z-50 w-full" data-scrolled="false">

  <!-- ── Glass background layer ──────────────────────────
       Separate div so we can transition its opacity
       independently without affecting child elements.       -->
  <div class="navbar-glass absolute inset-0" aria-hidden="true"></div>

  <!-- ── Gradient separator (fades at edges, like Tailwind) -->
  <div
    class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-border to-transparent"
    aria-hidden="true"
  ></div>

  <!-- ── Top edge highlight — the "glass pane" top rim ── -->
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/[0.07] to-transparent"
    aria-hidden="true"
  ></div>

  <!-- ── Main content row ────────────────────────────── -->
  <div
    class="relative mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5">
      <span class="block h-6 w-6 text-terminal [&>svg]:h-full [&>svg]:w-full">
        <LogoIcon />
      </span>
      <span class="font-sans text-lg font-semibold tracking-tight">BetterTUI</span>
    </a>

    <!-- Center nav -->
    <nav class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-1 md:flex">
      <a
        href="/getting-started/introduction"
        class="rounded-md px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground"
      >Docs</a>
      <a
        href="/performance"
        class="rounded-md px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground"
      >Performance</a>
      <a
        href="/blog"
        class="rounded-md px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground"
      >Blog</a>
    </nav>

    <!-- Right actions -->
    <div class="flex items-center gap-2">
      <ThemeToggle client:load />

      <div class="hidden items-center gap-2 sm:flex">
        <div class="h-4 w-px bg-border"></div>

        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
          <Button variant="outline" size="sm" className="gap-1.5 bg-transparent">
            <GithubIcon class="h-3.5 w-3.5" />
            Star on GitHub
          </Button>
        </a>

        <a href="/getting-started/quick-start">
          <Button size="sm">Get Started</Button>
        </a>
      </div>

      <!-- Mobile toggle -->
      <button
        id="mobile-menu-toggle"
        class="flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="block h-5 w-5 [&>svg]:h-full [&>svg]:w-full">
          <MenuIcon />
        </span>
      </button>
    </div>
  </div>

  <!-- ── Mobile menu panel ─────────────────────────────── -->
  <div id="mobile-menu" class="navbar-mobile hidden border-t border-border/40 px-4 py-3 md:hidden">
    <nav class="flex flex-col">
      <a
        href="/getting-started/introduction"
        class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground"
      >Docs</a>
      <a
        href="/performance"
        class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground"
      >Performance</a>
      <a
        href="/blog"
        class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground"
      >Blog</a>
      <div class="my-2 h-px bg-border/40"></div>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground"
      >GitHub</a>
      <a
        href="/getting-started/quick-start"
        class="mt-1 rounded-md px-3 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted/60"
      >Get Started</a>
    </nav>
  </div>
</header>

<style>
  /* ── Glass panel ──────────────────────────────────────
     At page-top: near-transparent so hero orbs show through.
     On scroll: transitions to a solid-enough bg to keep
     text readable over any page content below.              */
  .navbar-glass {
    background: oklch(1 0 0 / 0);
    backdrop-filter: blur(20px) saturate(1.8);
    -webkit-backdrop-filter: blur(20px) saturate(1.8);
    transition: background 250ms ease;
  }
  :global(.dark) .navbar-glass {
    background: oklch(0.10 0.022 265 / 0);
  }

  /* Scrolled — more opaque */
  #navbar[data-scrolled="true"] .navbar-glass {
    background: oklch(1 0 0 / 0.82);
  }
  :global(.dark) #navbar[data-scrolled="true"] .navbar-glass {
    background: oklch(0.10 0.022 265 / 0.88);
  }

  /* ── Mobile panel — always opaque enough to be usable ── */
  .navbar-mobile {
    backdrop-filter: blur(20px) saturate(1.8);
    -webkit-backdrop-filter: blur(20px) saturate(1.8);
    background: oklch(1 0 0 / 0.92);
  }
  :global(.dark) .navbar-mobile {
    background: oklch(0.10 0.022 265 / 0.96);
  }
</style>

<script>
  const navbar = document.getElementById("navbar");
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");

  // Scroll-aware opacity
  if (navbar) {
    const onScroll = () => {
      navbar.setAttribute("data-scrolled", window.scrollY > 24 ? "true" : "false");
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  // Mobile menu toggle
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      menu.classList.toggle("hidden");
      menu.classList.toggle("flex");
    });
  }
</script>
