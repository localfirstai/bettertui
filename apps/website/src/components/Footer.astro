---
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-bg-muted">
  <div class="container py-12">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="text-lg font-bold">
          <span class="gradient-text">BetterTUI</span>
        </a>
        <p class="mt-3 text-sm text-text-muted">
          High-performance terminal UI framework powered by Rust and TypeScript.
        </p>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-semibold">Product</h3>
        <ul class="space-y-2">
          <li><a href="/docs/getting-started/introduction" class="text-sm text-text-muted transition-colors hover:text-text">Documentation</a></li>
          <li><a href="/docs/components/overview" class="text-sm text-text-muted transition-colors hover:text-text">Components</a></li>
          <li><a href="/docs/api/core" class="text-sm text-text-muted transition-colors hover:text-text">API Reference</a></li>
          <li><a href="/blog" class="text-sm text-text-muted transition-colors hover:text-text">Blog</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-semibold">Resources</h3>
        <ul class="space-y-2">
          <li><a href="/docs/guides/theming" class="text-sm text-text-muted transition-colors hover:text-text">Theming</a></li>
          <li><a href="/docs/guides/custom-widgets" class="text-sm text-text-muted transition-colors hover:text-text">Custom Widgets</a></li>
          <li><a href="/docs/guides/animations" class="text-sm text-text-muted transition-colors hover:text-text">Animations</a></li>
          <li><a href="/docs/guides/migration-from-ink" class="text-sm text-text-muted transition-colors hover:text-text">Migration from Ink</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-semibold">Community</h3>
        <ul class="space-y-2">
          <li>
            <a href="https://github.com/bettertui/bettertui" target="_blank" rel="noopener noreferrer" class="text-sm text-text-muted transition-colors hover:text-text">
              GitHub
            </a>
          </li>
          <li>
            <a href="https://github.com/bettertui/bettertui/discussions" target="_blank" rel="noopener noreferrer" class="text-sm text-text-muted transition-colors hover:text-text">
              Discussions
            </a>
          </li>
          <li>
            <a href="https://github.com/bettertui/bettertui/issues" target="_blank" rel="noopener noreferrer" class="text-sm text-text-muted transition-colors hover:text-text">
              Issues
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-border pt-8 md:flex-row">
      <p class="text-sm text-text-subtle">&copy; {year} BetterTUI. MIT License.</p>
      <div class="flex items-center gap-4">
        <a href="https://github.com/bettertui/bettertui/blob/main/LICENSE" class="text-sm text-text-subtle transition-colors hover:text-text">License</a>
        <a href="https://github.com/bettertui/bettertui/blob/main/CONTRIBUTING.md" class="text-sm text-text-subtle transition-colors hover:text-text">Contributing</a>
      </div>
    </div>
  </div>
</footer>
