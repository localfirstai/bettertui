---
import {
  GITHUB_CONTRIBUTING_URL,
  GITHUB_DISCUSSIONS_URL,
  GITHUB_ISSUES_URL,
  GITHUB_LICENSE_URL,
  GITHUB_URL,
} from "@lib/constants";

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-muted/30">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2.5">
          <svg class="h-8 w-8 text-terminal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="3" width="20" height="18" rx="2" />
            <polyline points="8 10 11 13 8 16" />
            <line x1="14" y1="16" x2="16" y2="16" />
          </svg>
          <span class="font-sans text-lg font-semibold tracking-tight">BetterTUI</span>
        </a>
        <p class="mt-3 text-sm text-muted-foreground">
          The TypeScript-first toolkit for building beautiful, interactive terminal interfaces.
        </p>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-semibold">Product</h3>
        <ul class="space-y-2">
          <li><a href="/docs/getting-started/introduction" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Documentation</a></li>
          <li><a href="/docs/components/overview" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Components</a></li>
          <li><a href="/docs/api/core" class="text-sm text-muted-foreground transition-colors hover:text-foreground">API Reference</a></li>
          <li><a href="/blog" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Blog</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-semibold">Resources</h3>
        <ul class="space-y-2">
          <li><a href="/docs/guides/theming" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Theming</a></li>
          <li><a href="/docs/guides/custom-widgets" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Custom Widgets</a></li>
          <li><a href="/docs/guides/animations" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Animations</a></li>
          <li><a href="/docs/guides/migration-from-ink" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Migration from Ink</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-semibold">Community</h3>
        <ul class="space-y-2">
          <li>
            <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" /></svg>
              GitHub
            </a>
          </li>
          <li>
            <a href={GITHUB_DISCUSSIONS_URL} target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Discussions</a>
          </li>
          <li>
            <a href={GITHUB_ISSUES_URL} target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Issues</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-border pt-8 md:flex-row">
      <p class="text-sm text-muted-foreground">&copy; {year} BetterTUI. MIT License.</p>
      <div class="flex items-center gap-4">
        <a href={GITHUB_LICENSE_URL} class="text-sm text-muted-foreground transition-colors hover:text-foreground">License</a>
        <a href={GITHUB_CONTRIBUTING_URL} class="text-sm text-muted-foreground transition-colors hover:text-foreground">Contributing</a>
        <span class="text-sm text-muted-foreground/60">Built with Astro</span>
      </div>
    </div>
  </div>
</footer>
="text-sm text-muted-foreground transition-colors hover:text-foreground">Contributing</a>
        <span class="text-sm text-muted-foreground/60">Built with Astro</span>
      </div>
    </div>
  </div>
</footer>
