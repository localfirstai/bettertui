---
import { computeImprovement, sampleReport } from "@lib/bench";

const ot = sampleReport.opentui;
const bt = sampleReport.bettertui;

function avg(arr: number[]): number {
  return arr.reduce((a, b) => a + b, 0) / arr.length;
}

const otAvgLayout = avg(ot.map((m) => m.layoutMs));
const btAvgLayout = avg(bt.map((m) => m.layoutMs));
const otAvgRender = avg(ot.map((m) => m.renderMs));
const btAvgRender = avg(bt.map((m) => m.renderMs));
const otAvgFps = avg(ot.map((m) => m.fps));
const btAvgFps = avg(bt.map((m) => m.fps));
const otAvgMem = avg(ot.map((m) => m.memoryRssMb));
const btAvgMem = avg(bt.map((m) => m.memoryRssMb));
const otAvgStartup = avg(ot.map((m) => m.startupMs));
const btAvgStartup = avg(bt.map((m) => m.startupMs));

const cards = [
  {
    label: "Avg Layout Time",
    otValue: `${otAvgLayout.toFixed(2)}ms`,
    btValue: `${btAvgLayout.toFixed(2)}ms`,
    improvement: computeImprovement(otAvgLayout, btAvgLayout, true),
    icon: "M4 6h16M4 12h16M4 18h10",
    lowerIsBetter: true,
  },
  {
    label: "Avg Render Time",
    otValue: `${otAvgRender.toFixed(2)}ms`,
    btValue: `${btAvgRender.toFixed(2)}ms`,
    improvement: computeImprovement(otAvgRender, btAvgRender, true),
    icon: "M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25",
    lowerIsBetter: true,
  },
  {
    label: "Avg FPS",
    otValue: `${Math.round(otAvgFps)}`,
    btValue: `${Math.round(btAvgFps)}`,
    improvement: computeImprovement(otAvgFps, btAvgFps, false),
    icon: "M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z",
    lowerIsBetter: false,
  },
  {
    label: "Avg Memory (RSS)",
    otValue: `${otAvgMem.toFixed(1)}MB`,
    btValue: `${btAvgMem.toFixed(1)}MB`,
    improvement: computeImprovement(otAvgMem, btAvgMem, true),
    icon: "M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z",
    lowerIsBetter: true,
  },
  {
    label: "Avg Startup",
    otValue: `${otAvgStartup.toFixed(0)}ms`,
    btValue: `${btAvgStartup.toFixed(0)}ms`,
    improvement: computeImprovement(otAvgStartup, btAvgStartup, true),
    icon: "M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z",
    lowerIsBetter: true,
  },
  {
    label: "Bundle Size",
    otValue: `${(ot[0].bundleKb / 1024).toFixed(1)}MB`,
    btValue: `${(bt[0].bundleKb / 1024).toFixed(1)}MB`,
    improvement: computeImprovement(ot[0].bundleKb, bt[0].bundleKb, true),
    icon: "M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z",
    lowerIsBetter: true,
  },
];
---

<section class="py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <p class="font-mono text-xs font-medium uppercase tracking-wider text-terminal">
        Overview
      </p>
      <h2 class="text-section mt-2">Key Metrics at a Glance</h2>
      <p class="text-section-sub mt-4 text-muted-foreground">
        Aggregated results across all 10 benchmark workloads. Lower is better for timing and
        memory; higher is better for FPS.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((card) => (
          <article class="group relative overflow-hidden rounded-xl border border-border/60 bg-card/50 p-6 backdrop-blur-sm transition-all duration-300 hover:border-border hover:-translate-y-0.5 hover:shadow-lg">
            <div class="mb-4 flex items-center justify-between">
              <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-terminal-muted text-terminal">
                <svg
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={card.icon} />
                </svg>
              </div>
              {card.improvement.better && (
                <span class="inline-flex items-center gap-1 rounded-full bg-terminal-muted px-2.5 py-0.5 font-mono text-xs font-medium text-terminal">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2 17L14 5M14 5H7M14 5v7" />
                  </svg>
                  {card.improvement.percent.toFixed(0)}%
                </span>
              )}
            </div>

            <h3 class="mb-3 text-sm font-medium text-muted-foreground">{card.label}</h3>

            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs text-muted-foreground/70">OpenTUI</span>
                <span class="font-mono text-sm text-muted-foreground">{card.otValue}</span>
              </div>
              <div class="flex items-center justify-between rounded-md bg-terminal-muted/40 px-2 py-1">
                <span class="font-mono text-xs font-medium text-terminal">BetterTUI</span>
                <span class="font-mono text-sm font-semibold text-terminal">{card.btValue}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
