---

<section class="border-t border-border py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <p class="font-mono text-xs font-medium uppercase tracking-wider text-terminal">
        Render Pipeline
      </p>
      <h2 class="text-section mt-2">Frame Generation Breakdown</h2>
      <p class="text-section-sub mt-4 text-muted-foreground">
        Each phase of the render pipeline, measured independently. BetterTUI's Rust engine
        accelerates every stage.
      </p>
    </div>

    <div class="mx-auto max-w-5xl">
      <div class="grid gap-4 md:grid-cols-3 lg:grid-cols-6">
        {
          pipelineSteps.map((step, i) => (
            <div class="relative">
              {i < pipelineSteps.length - 1 && (
                <svg
                  class="absolute -right-3 top-1/2 z-10 hidden h-6 w-6 -translate-y-1/2 text-muted-foreground/30 lg:block"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              )}
              <div class="rounded-xl border border-border/60 bg-card/50 p-4 backdrop-blur-sm transition-colors hover:border-border">
                <div class="mb-3 flex items-center gap-2">
                  <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-terminal-muted text-terminal">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d={step.icon} />
                    </svg>
                  </span>
                  <span class="text-sm font-medium">{step.phase}</span>
                </div>
                <div class="space-y-1.5">
                  <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground/70">OpenTUI</span>
                    <span class="font-mono text-xs text-muted-foreground">{step.opentui}</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-terminal">BetterTUI</span>
                    <span class="font-mono text-xs font-semibold text-terminal">{step.bettertui}</span>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
