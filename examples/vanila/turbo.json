{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["@bettertui/core#build"],
      "outputs": ["dist/**"]
    },
    "build:native": {
      "dependsOn": ["@bettertui/core#build:native"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "format:check": {
      "cache": false
    },
    "typecheck": {},
    "test": {
      "dependsOn": ["@bettertui/core#build"]
    },
    "clean": {
      "cache": false
    }
  }
}
