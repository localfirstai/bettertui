{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "paths": {
      "~/*": ["./src/*"],
      "@bettertui/core": ["../core/src/index.ts"],
      "@bettertui/react": ["../react/src/index.ts"],
      "@bettertui/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src", "scripts", "test"]
}
